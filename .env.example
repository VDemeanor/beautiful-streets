# Local file by default. For a hosted database, use a Turso/libSQL URL and token.
DATABASE_URL=file:./data/beautiful-streets.db
DATABASE_AUTH_TOKEN=
# Any MapLibre style URL. OpenFreeMap needs no key.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Set to "demo" to use the built-in synthetic grid instead of OpenStreetMap.
BS_SEED=
# Optional: a Google Maps Platform key (Maps JavaScript API) turns on the "Real" view with photorealistic buildings.
GOOGLE_MAPS_KEY=
